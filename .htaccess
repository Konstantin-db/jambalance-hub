# Preserve the user bearer token for the Supabase PHP proxy on Apache FastCGI.
<Files "supabase-proxy.php">
    CGIPassAuth On
</Files>

# Client cards contain active interface changes, so always revalidate these files.
<FilesMatch "^(clients\.html|clients\.js)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>
